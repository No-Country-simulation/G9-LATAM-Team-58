# cp .env.example .env y rellenar. Se carga con:
#   uvicorn app.main:app --reload --env-file .env

# Bucket de OCI Object Storage donde vive model.joblib.
MODEL_BUCKET=techmind-data

# Atajo de dev: si apunta a un archivo existente, load_model() lo carga directo
# y NO toca OCI (no hace falta ~/.oci/config para levantar el servicio local).
# Comenta o borra la línea para forzar la descarga real del bucket.
MODEL_LOCAL_PATH=models/model.joblib
