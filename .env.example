# cp .env.example .env y rellenar. .env NUNCA se commitea.

# --- Autonomous Database -----------------------------------------------------
# Alias de tnsnames.ora, dentro del wallet descomprimido:
# techmind_high / techmind_tp / techmind_tpurgent
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@techmind_tp?TNS_ADMIN=/app/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=

# Ruta del wallet al ejecutar data/seed_db.py fuera del contenedor. Vacío en la VM.
TNS_ADMIN=
# Solo si el wallet se descargó con contraseña.
WALLET_PASSWORD=

# --- Object Storage ----------------------------------------------------------
# Sin claves: la VM se autentica con Instance Principal.
OCI_NAMESPACE=
MODEL_BUCKET=techmind-data

# Las credenciales de Kaggle van en Colab Secrets, no aquí: el notebook de EDA/ETL
# no lee este fichero.
