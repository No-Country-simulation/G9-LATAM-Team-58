# cp scripts/.env.example scripts/.env y rellenar. scripts/.env NUNCA se commitea.
#
# Si ya tienes el .env de la raíz relleno (el que usa Docker Compose), puedes
# reutilizarlo en vez de duplicar credenciales: python -m scripts.seed_db --env ../.env

# --- Autonomous Database -----------------------------------------------------
# Alias de tnsnames.ora, dentro del wallet descomprimido:
# techmind_high / techmind_tp / techmind_tpurgent
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@techmind_tp?TNS_ADMIN=/app/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=

# Ruta del wallet descomprimido en TU máquina (no la de la VM).
TNS_ADMIN=
# Solo si el wallet se descargó con contraseña.
WALLET_PASSWORD=

# --- Corpus --------------------------------------------------------------------
# Ruta a corpus_index.npz. Si no se define, usa --index o el default relativo
# model/corpus_index.npz (asume que se corre desde la raíz del repo). Puede
# apuntar a cualquier ruta del disco, no solo dentro del repo.
CORPUS_INDEX_PATH=
