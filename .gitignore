# === Hard rules: never commit models, datasets or secrets, anywhere in the repo ===
*.joblib
*.jsonl
*.csv
.env
.env.*
!.env.example

# Oracle wallet — mTLS credentials for the Autonomous Database. Lives on the VM.
wallet/
*_wallet.zip

# Model artifacts and corpus index (local mirrors). They live on the OCI bucket
# and the Autonomous Database — never commit them.
model/
models/
processed/

# Local-only compose override (publishes inference:8000 for dev). Never on the VM.
docker-compose.override.yml

# === Root-level runtime / tooling ===
node_modules/
*.log

# === IDE / OS ===
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
