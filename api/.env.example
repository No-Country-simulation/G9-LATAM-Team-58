# Spring Boot NO carga .env de forma nativa. Este archivo es solo la lista de
# qué exportar antes de `./mvnw spring-boot:run` — o lo que ya llega por el
# bloque `environment:` de docker-compose.yml cuando corre en Compose.
#
# Ejemplo (bash):  export $(grep -v '^#' .env | xargs)   # o exportarlas a mano

# --- Autonomous Database (solo con SPRING_PROFILES_ACTIVE=db) ---------------
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@techmind_tp?TNS_ADMIN=/app/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=

# Ruta del wallet descomprimido.
TNS_ADMIN=

# --- inference/ ---------------------------------------------------------------
# Default ya apunta a la VM de referencia; solo hace falta en local si apuntas
# a otra instancia.
INFERENCE_BASE_URL=http://localhost:8000
