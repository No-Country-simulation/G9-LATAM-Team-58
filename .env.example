# cp .env.example .env y rellenar. .env NUNCA se commitea.
#
# Solo las variables que Docker Compose interpola en docker-compose.yml. Las que
# usa un solo servicio viven en el .env.example de su propia carpeta —
# api/, inference/, web/, scripts/.

# --- Autonomous Database -----------------------------------------------------
# Alias de tnsnames.ora, dentro del wallet descomprimido:
# techmind_high / techmind_tp / techmind_tpurgent
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@techmind_tp?TNS_ADMIN=/app/wallet
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=

# --- Object Storage ----------------------------------------------------------
# Sin claves: la VM se autentica con Instance Principal. El namespace no se
# configura, lo resuelve el propio cliente al arrancar.
MODEL_BUCKET=techmind-data
